# ============================================================================
# TAGO 운영(AWS EC2) 환경변수 템플릿
# EC2 서버 프로젝트 루트에 `.env` 로 복사 후 실제 값 입력 + `chmod 600 .env`
# ============================================================================

# Docker Hub 이미지 (compose.app.yml 에서 pull 할 이미지)
TAGO_BACKEND_IMAGE=<your-dockerhub-id>/tago-backend:latest
TAGO_FRONTEND_IMAGE=<your-dockerhub-id>/tago-frontend:latest

# Application
SERVER_PORT=8080
# 실제 서비스 도메인 또는 EC2 퍼블릭 IP (쉼표 구분)
TAGO_CORS_ALLOWED_ORIGINS=http://<EC2-PUBLIC-IP>,http://localhost

# Database (compose.data.yml 사용 시 호스트명은 postgres / 외부 RDS·별도 EC2 시 해당 엔드포인트·프라이빗IP)
DB_NAME=tago_db
DB_URL=jdbc:postgresql://postgres:5432/tago_db
DB_USERNAME=postgres
DB_PASSWORD=<STRONG_DB_PASSWORD>

# Redis (compose.data.yml 사용 시 호스트명은 redis / 외부 ElastiCache·별도 EC2 시 해당 엔드포인트·프라이빗IP)
REDIS_DB_URL=redis
REDIS_DB_PORT=6379
REDIS_DB_DATABASE=0
REDIS_DB_PASSWORD=

# JWT (최소 32자 이상 랜덤 문자열)
JWT_SECRET=<LONG_RANDOM_SECRET_AT_LEAST_32_CHARS>
JWT_EXPIRATION=3600000

# Public Data Portal (TAGO OpenAPI)
TAGO_SERVICE_KEY=<YOUR_TAGO_SERVICE_KEY>
TAGO_STARTUP_SYNC_ENABLED=true
TAGO_SYNC_MOCK_ENABLED=false

# Email (SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<YOUR_EMAIL>
SPRING_MAIL_PASSWORD=<YOUR_APP_PASSWORD>

# Monitoring (Grafana)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<STRONG_GRAFANA_PASSWORD>
