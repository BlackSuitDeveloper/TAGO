# ============================================================================
# EC2-data 환경변수 템플릿 (cp .env.example .env && chmod 600 .env)
# ============================================================================

# PostgreSQL
DB_NAME=tago_db
DB_USERNAME=postgres
DB_PASSWORD=<STRONG_DB_PASSWORD>

# Redis (대기열 데이터 보호: 비밀번호 필수, noeviction 정책)
REDIS_PASSWORD=<STRONG_REDIS_PASSWORD>
REDIS_MAXMEMORY=256mb
