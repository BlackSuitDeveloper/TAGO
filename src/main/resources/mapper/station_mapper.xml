<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="Station">

    <select id="selectStationList" resultType="com.kedu.tago.station.StationDTO">
        SELECT
            nodeid,
            nodename,
            citycode,
            cityname,
            node_address
        FROM station
        ORDER BY nodename ASC
    </select>

</mapper>
