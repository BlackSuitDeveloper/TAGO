<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kedu.tago.payment.PaymentMapper">

    <insert id="insertPayment" parameterType="com.kedu.tago.payment.dto.PaymentDTO"
            useGeneratedKeys="true" keyProperty="paymentSeq" keyColumn="payment_seq">
        INSERT INTO payment (
            reservation_seq,
            order_id,
            payment_key,
            amount,
            status,
            requested_at,
            approved_at
        )
        VALUES (
            #{reservationSeq},
            #{orderId},
            #{paymentKey},
            #{amount},
            #{status},
            #{requestedAt},
            #{approvedAt}
        )
    </insert>

</mapper>
