<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kedu.tago.member.MemberMapper">

    <!-- 로그인 비밀번호 확인 | POST /api/v1/auth/login (MemberService.isMember) -->
    <select id="getPasswordById" resultType="String">
        SELECT pw
        FROM member
        WHERE member_id = #{id}
    </select>

    <!-- 로그인 시 권한 조회 | POST /api/v1/auth/login (MemberService.getRole) -->
    <select id="getRoleById" resultType="String">
        SELECT role
        FROM member
        WHERE member_id = #{id}
    </select>

    <!-- 회원가입 아이디 중복 확인 | GET /api/v1/member/checkId (MemberService.checkId) -->
    <select id="checkId" parameterType="string" resultType="int">
        SELECT COUNT(*)
        FROM member
        WHERE member_id = #{id}
    </select>

    <!-- 회원가입 | POST /api/v1/member (MemberService.insertMember) -->
    <insert id="insertMember" parameterType="com.kedu.tago.member.dto.MemberSignupRequestDTO">
        INSERT INTO member (member_id, pw, name, phone, email, zipcode, address1, address2, role)
        VALUES (#{id}, #{pw}, #{name}, #{phone}, #{email}, #{zipcode}, #{address1}, #{address2}, 'USER')
    </insert>

    <!-- 내 정보 조회 | GET /api/v1/member/mypage, POST /api/v1/member/password/send-code, POST /api/v1/member/password/verify, PUT /api/v1/member/password (MemberService.selectMember) -->
    <select id="selectMember" parameterType="string"
            resultType="com.kedu.tago.member.dto.MemberProfileResponseDTO">
        SELECT
            member_id AS id,
            name,
            phone,
            email,
            zipcode,
            address1,
            address2,
            role,
            created_at AS createdAt
        FROM member
        WHERE member_id = #{id}
    </select>

    <!-- 회원 정보 수정 | PUT /api/v1/member (MemberService.updateMember) -->
    <update id="updateMember" parameterType="com.kedu.tago.member.dto.MemberUpdateRequestDTO">
        UPDATE member
        SET name = #{name},
            phone = #{phone},
            email = #{email},
            zipcode = #{zipcode},
            address1 = #{address1},
            address2 = #{address2}
        WHERE member_id = #{id}
    </update>

    <!-- 회원 탈퇴 | DELETE /api/v1/member (MemberService.deleteId) -->
    <delete id="deleteId" parameterType="string">
        DELETE FROM member
        WHERE member_id = #{id}
    </delete>

    <!-- 이름과 이메일로 아이디 찾기 | POST /api/v1/auth/find-id/send-code, POST /api/v1/auth/find-id/verify (MemberService.findIdByNameAndEmail) -->
    <select id="findIdByNameAndEmail" resultType="String">
        SELECT member_id
        FROM member
        WHERE name = #{name}
          AND email = #{email}
        LIMIT 1
    </select>

    <!-- 아이디와 이메일 일치 확인 | POST /api/v1/auth/reset-password/send-code (MemberService.validateMemberByIdAndEmail) -->
    <select id="countByIdAndEmail" resultType="int">
        SELECT COUNT(*)
        FROM member
        WHERE member_id = #{id}
          AND email = #{email}
    </select>

    <!-- 비밀번호 변경 | POST /api/v1/auth/reset-password, PUT /api/v1/member/password (MemberService.updatePassword) -->
    <update id="updatePassword">
        UPDATE member
        SET pw = #{pw}
        WHERE member_id = #{id}
    </update>

</mapper>
