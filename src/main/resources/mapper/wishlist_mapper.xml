<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kedu.tago.wishlist.WishListMapper">

    <select id="selectWishList" parameterType="string" resultType="long">
        SELECT schedule_seq FROM wishlist WHERE member_id = #{memberId}
    </select>

    <insert id="insertWish">
        INSERT INTO wishlist (member_id, schedule_seq) VALUES (#{memberId}, #{scheduleSeq})
    </insert>

    <delete id="deleteWish">
        DELETE FROM wishlist WHERE member_id = #{memberId} AND schedule_seq = #{scheduleSeq}
    </delete>

</mapper>
