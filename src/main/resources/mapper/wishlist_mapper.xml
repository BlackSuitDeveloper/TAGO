<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kedu.tago.wishlist.WishListMapper">

    <!-- 찜 목록 조회 | GET /api/v1/wishlist (WishListService.getWishList) -->
    <select id="selectWishList" parameterType="string" resultType="long">
        SELECT schedule_seq
        FROM wishlist
        WHERE member_id = #{memberId}
    </select>

    <!-- 찜 추가 | POST /api/v1/wishlist/{scheduleSeq} (WishListService.addWish) -->
    <!-- DB-2: MAX()+1 대신 PostgreSQL 시퀀스 DEFAULT + ON CONFLICT DO NOTHING 으로 동시성 안전 확보 -->
    <insert id="insertWish">
        INSERT INTO wishlist (member_id, schedule_seq)
        VALUES (#{memberId}, #{scheduleSeq})
        ON CONFLICT (member_id, schedule_seq) DO NOTHING
    </insert>

    <!-- 찜 삭제 | DELETE /api/v1/wishlist/{scheduleSeq} (WishListService.deleteWish) -->
    <delete id="deleteWish">
        DELETE FROM wishlist
        WHERE member_id = #{memberId}
          AND schedule_seq = #{scheduleSeq}
    </delete>

</mapper>
