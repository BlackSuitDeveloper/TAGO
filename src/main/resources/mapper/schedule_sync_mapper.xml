<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kedu.tago.sync.ScheduleSyncMapper">

    <!-- 운행 일정 중복 확인 | POST /api/admin/sync/schedules, POST /api/admin/sync/schedules/range, POST /api/admin/sync/mock, 매일 03:00 배치, 서버 시작 시 SyncStartupRunner (ScheduleSyncService.syncSchedulesByDate) -->
    <select id="existsSchedule" resultType="boolean">
        SELECT EXISTS (
            SELECT 1
            FROM schedule
            WHERE trainno = #{trainno}
              AND depplacename = #{depNodeId}
              AND arrplacename = #{arrNodeId}
              AND depplandtime = #{depTime}
        )
    </select>

    <!-- 운행 일정 저장 | POST /api/admin/sync/schedules, POST /api/admin/sync/schedules/range, POST /api/admin/sync/mock, 매일 03:00 배치, 서버 시작 시 SyncStartupRunner (ScheduleSyncService.syncSchedulesByDate) -->
    <insert id="insertSchedule" parameterType="com.kedu.tago.sync.dto.ScheduleInsertDTO"
            useGeneratedKeys="true" keyProperty="scheduleSeq" keyColumn="schedule_seq">
        INSERT INTO schedule (
            trainno,
            depplacename,
            arrplacename,
            depplandtime,
            arrplandtime,
            booking_open_at,
            first_price,
            standard_price,
            status
        )
        VALUES (
            #{trainno},
            #{depNodeId},
            #{arrNodeId},
            #{depTime},
            #{arrTime},
            #{bookingOpenAt},
            #{firstPrice},
            #{standardPrice},
            'SCHEDULED'
        )
    </insert>

</mapper>
